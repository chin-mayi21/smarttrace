rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    function isSignedIn() {
      return request.auth != null;
    }

    function myRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isOfficer() {
      return isSignedIn() && myRole() == "officer";
    }

    function isBusiness() {
      return isSignedIn() && myRole() == "business";
    }

    function isConsumer() {
      return isSignedIn() && myRole() == "consumer";
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // /users/{userId}
    // ─────────────────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Users can only read/write their own profile.
      // Officers can read any user profile (e.g. to look up a business).
      allow read:  if isOwner(userId) || isOfficer();
      allow write: if isOwner(userId);
    }

    // ─────────────────────────────────────────────────────────────────────────
    // /products/{productId}  — DPCR Registry
    // ─────────────────────────────────────────────────────────────────────────
    match /products/{productId} {
      // Everyone logged in can read the DPCR registry (consumer scan, officer audit).
      allow read: if isSignedIn();

      // Only a business or officer can create/update a product record.
      // Consumers must NOT write product data.
      allow create, update: if isBusiness() || isOfficer();

      // Only officers can delete (e.g. revoke a fraudulent registration).
      allow delete: if isOfficer();
    }

    // ─────────────────────────────────────────────────────────────────────────
    // /inspections/{inspectionId}
    // ─────────────────────────────────────────────────────────────────────────
    match /inspections/{inspectionId} {
      // Officers and businesses can read inspections.
      // Consumers must NOT see raw inspection records.
      allow read: if isOfficer() || isBusiness();

      // Only officers may create or update inspection records.
      allow create, update: if isOfficer();

      // No one deletes inspection evidence (immutable audit trail).
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // /complaints/{complaintId}
    // ─────────────────────────────────────────────────────────────────────────
    match /complaints/{complaintId} {
      // Consumer can read only their own complaints.
      // Officers can read all complaints.
      // Business should NOT see competitor complaints.
      allow read: if isOfficer()
                  || (isConsumer() && resource.data.complainantUid == request.auth.uid);

      // Any authenticated user can file a complaint (consumer, officer).
      // Validate that the complaint is filed by the requesting user.
      allow create: if isSignedIn()
                    && request.resource.data.complainantUid == request.auth.uid;

      // Only officers may update complaint status (assign, resolve).
      // Consumers cannot modify a submitted complaint.
      allow update: if isOfficer();

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // /traceability/{batchNo}
    // ─────────────────────────────────────────────────────────────────────────
    match /traceability/{batchNo} {
      // Officers and businesses can read traceability chains.
      allow read: if isOfficer() || isBusiness();

      // Only officers or businesses (e.g. manufacturer uploading a batch manifest)
      // can write traceability data.
      allow create, update: if isOfficer() || isBusiness();

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // /ecommerceListings/{listingId}
    // ─────────────────────────────────────────────────────────────────────────
    match /ecommerceListings/{listingId} {
      // Officers and businesses can read listings.
      allow read: if isOfficer() || isBusiness();

      // Businesses can manage their own listings; officers can update for enforcement.
      allow create: if isBusiness();
      allow update: if isBusiness() || isOfficer();
      allow delete: if isOfficer();
    }
  }
}
